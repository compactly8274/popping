# =============================================================================
# Popping configuration
# Copy to .env and edit. The docker-compose stack reads this file directly.
# =============================================================================

# --- Core --------------------------------------------------------------------

# Bind host for the Vite dev server (the only published port in the stack).
# Default: 0.0.0.0 (LAN-reachable). Set to 127.0.0.1 for host-only access.
POPPING_FRONTEND_HOST=0.0.0.0

# Non-standard port to avoid the usual 3000/5173/8000/8080 collisions.
# Change to whatever is free on the host.
POPPING_FRONTEND_PORT=14789

# --- Image source (GHCR prebuilt images) -----------------------------------
#
# POPPING_IMAGE_TAG picks which GHCR tag to run.
#   latest       (default) — always tracks main, auto-updates on `up`
#   sha-<sha>               — exact commit (immutable, what we test)
#   pr-<num>                — test a PR build
# Set POPPING_IMAGE_OWNER if you forked the repo.
#
# POPPING_PULL_POLICY controls when `docker compose up` re-fetches the
# image from GHCR. Default in docker-compose.yml is ``always`` which
# checks the registry on every ``up`` and pulls when the digest has
# moved — this is what makes ``latest`` actually track main. The
# docker-compose fallback already enforces this; you only need to
# override it here to a different value (see below). Most users
# should leave this line UNSET so the compose default wins.
#
# Other valid values:
#   missing  — pull only if no local image with this tag exists
#              (silently keeps you on an old release when ``latest``
#              rotates)
#   never    — never pull; require manual ``docker compose pull``
#              first. Use this when you want to be deliberate about
#              upgrades (e.g. production with manual change windows).
#   if_not_present — alias of ``missing``
#
# To run from source instead (with hot-reload), use the dev override:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up
#
POPPING_IMAGE_OWNER=compactly8274
POPPING_IMAGE_TAG=latest
# POPPING_PULL_POLICY=always

# --- Database ----------------------------------------------------------------

# Used by docker-compose to create the postgres role + database. The backend
# constructs DATABASE_URL from these.
POSTGRES_USER=popping
POSTGRES_PASSWORD=***
POSTGRES_DB=popping
# Override these when the DB isn't on the default docker-compose
# network (e.g. external Postgres, host-networked DB, k8s cluster).
# Default: ``postgres`` host on port 5432 — the docker-compose service
# name. Set BOTH if you change either.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# --- LLM providers (all optional; phase 2+) ----------------------------------
#
# Each provider block is independent. Pick whichever you actually run. Phase 1
# never touches these.

# Ollama (local — recommended for embedding + scoring)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_SCORING=llama3.1:8b
OLLAMA_MODEL_BRIEF=llama3.1:8b
OLLAMA_MODEL_EMBEDDING=all-minilm

# Ollama Cloud (paid Ollama SaaS)
OLLAMA_CLOUD_API_KEY=OLLAMA...ING=
# Default scoring model is gpt-oss:20b (small, cheap, available in the
# Ollama Cloud catalog). Override per-use via the Settings UI which
# stores llm.model_scoring / llm.model_brief in the app_settings table.
# The DB value wins over this default — only matters on first boot
# before any UI edit (and on a fresh deploy with an empty table).
OLLAMA_CLOUD_MODEL_SCORING=gpt-oss:20b
OLLAMA_CLOUD_MODEL_BRIEF=glm-5.2

# Groq
GROQ_API_KEY=
GROQ_MODEL_SCORING=llama-3.1-8b-instant
GROQ_MODEL_BRIEF=llama-3.1-70b-versatile

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SCORING=claude-haiku-4-5
CLAUDE_MODEL_BRIEF=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_SCORING=gpt-4o-mini
OPENAI_MODEL_BRIEF=gpt-4o

# --- Source API keys (phase 2+) ---------------------------------------------
KEEPA_API_KEY=
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
# Optional GitHub PAT — bumps rate limit on the github_releases source from
# 60/hr to 5000/hr. Create at https://github.com/settings/tokens (no scopes
# needed for public release reads).
GITHUB_TOKEN=

# --- Notifications (phase 2+) ----------------------------------------------
# Phase 4 wires these up. The backend picks the first one that's set:
#   1. APPRISE_URL — opaque, covers 100+ services (Pushover, Telegram,
#      Discord, Slack, ntfy, email, ...). Examples:
#        pover://userkey/appkey
#        tgram://bottoken/chatid
#        discord://token/channel
#        ntfy://topic@ntfy.sh
#      See https://github.com/caronc/apprise/wiki for the full list.
#   2. PUSHOVER_USER_KEY + PUSHOVER_APP_TOKEN — direct fallback when
#      APPRISE_URL isn't set.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
APPRISE_URL=

# --- Phase 4: The Brief + notifications ---------------------------------
# UTC hour at which the scheduler generates the daily brief. Set to -1
# to disable the scheduled run (manual button only). 0-23.
BRIEF_SCHEDULE_HOUR=8
# Lookback window (hours) for the brief generator. Only entries
# ingested in the last N hours are considered. Filters on fetched_at
# (when the row landed in our DB), not published_at, so historical
# content like Wikipedia "on this day" ingested today doesn't pollute
# today's digest. 1-168 (1 hour to 1 week). Overridable at runtime via
# the app_settings key 'brief.window_hours'.
BRIEF_WINDOW_HOURS=24
# CVSS threshold (0-10) for the post-ingest CVE alert. Default 7.0
# (HIGH severity). Set to 0 to alert on every CVE ingest; set to 11 to
# disable the alert path entirely.
CVE_NOTIFY_MIN_CVSS=7.0
# How many days to keep rows in the notification_dedup ledger
# (one row per CVE URL or convergence slug that fired once). 30
# days is the right default — long enough to cover any reasonable
# "did the user re-trigger this?" window, short enough that the
# table stays tiny (single-digit MB at typical ingest rates).
# Set to 0 to disable the periodic prune (rows accumulate forever).
# NOTIFICATION_DEDUP_RETENTION_DAYS=30
# How long the framing tone-tagger caches LLM responses in the
# app_settings table before re-tagging a cluster. The cache is a
# cheap dedup so a cluster that gets re-classified at every hourly
# run doesn't pay the LLM cost 24 times in a day. 24h covers a full
# day's worth of hourly re-tagging; bump to 7d for a slower-turnover
# category. Set to 0 to disable the cache (every tick re-tags).
# LLM_TAGS_CACHE_TTL_SECONDS=86400
# Minimum number of distinct sources a slug must appear in (within
# CONVERGENCE_WINDOW_HOURS) to trigger a convergence alert Brief.
# Default 2.
CONVERGENCE_NOTIFY_THRESHOLD=2
# How often the convergence-check job runs. Cheap (one GROUP BY).
CONVERGENCE_CHECK_INTERVAL_MINUTES=15

# --- OIDC / login (optional) ------------------------------------------------
#
# When OIDC_ENABLED is false (the default), the dashboard runs as a
# single-user app with no login — fine for a local-only deployment. Flip
# it on for any LAN / public exposure.
#
# Provider notes:
#   - Authentik / Pocket-ID / Authelia (OIDC mode) / Keycloak / Auth0 /
#     Google all work; create a public client (no client secret) with
#     PKCE and set the redirect URI to "${PUBLIC_URL}/auth/callback".
#   - The backend fetches the IdP's discovery document on first /auth/login.
#
# Generate SESSION_SECRET with: openssl rand -hex 32
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid email profile
PUBLIC_URL=
# Additional CORS origins, comma-separated. The default behavior
# (PUBLIC_URL set, this unset) is to allow ONLY the PUBLIC_URL
# origin. Set this when the dashboard is accessed from a different
# host than the API (LAN IP from a phone, staging alias, the
# docker-host IP the proxy runs on). Each entry is a full origin
# like "http://192.168.1.10:8080" — no trailing slash needed, no
# scheme-less hostnames. Empty PUBLIC_URL + empty EXTRA_CORS_ORIGINS
# falls back to "*" for dev-mode compat (see app/main.py for the
# build logic + the startup log line that records the resolved
# allowlist count).
# EXTRA_CORS_ORIGINS=http://192.168.1.10:8080,http://lan.pop:8080
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=popping_session

# --- Local fallback user (optional) ---------------------------------------
#
# Hardcoded username + bcrypt-hashed password that bypasses OIDC. Useful
# when the IdP is down or you're testing without one. Reuses the same
# session cookie as OIDC, so a logged-in local user is indistinguishable
# downstream.
#
# Generate the hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
LOCAL_AUTH_ENABLED=false
LOCAL_USER_NAME=
LOCAL_USER_PASSWORD_HASH=
LOCAL_USER_EMAIL=

# --- Local bypass (optional) ------------------------------------------------
#
# When true, requests from the LOCAL_BYPASS_ALLOWED_CIDRS list below are
# treated as authenticated with a synthetic 'local-bypass' user — no
# login needed from the server's keyboard. Useful for headless
# deployments without a full OIDC stack.
#
# SECURITY: the IP is taken from the TCP peer only. X-Forwarded-For is
# ignored — it can be spoofed by any client and would let a LAN attacker
# claim a loopback identity. If you run behind a reverse proxy, terminate
# TLS at the proxy and have it speak to the backend on a private
# interface. Off by default for safety.
#
# Default CIDR list is loopback-only (127.0.0.0/8, ::1/128). To grant
# bypass to additional networks (e.g. a private LAN, Docker bridge),
# override LOCAL_BYPASS_ALLOWED_CIDRS below. **Any host on the
# allow-listed networks can then authenticate without a password.**
LOCAL_AUTH_BYPASS=false

# Comma-separated CIDRs. Loopback-only by default; widen at your own
# risk. Common additions: 10.0.0.0/8 (private class A), 172.16.0.0/12
# (Docker bridge / RFC1918), fe80::/10 (IPv6 link-local).
LOCAL_BYPASS_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# How often to delete expired session rows. The scheduler picks this up.
SESSION_PURGE_INTERVAL_SECONDS=3600

# --- Phase 2: embeddings ------------------------------------------------------
#
# sentence-transformers model used to embed entry text at ingest time.
# The default (all-MiniLM-L6-v2) produces 384-dim vectors and matches
# the Vector(384) column on entries. Runs on CPU. Set EMBEDDING_ENABLED=false
# to skip the pipeline entirely on memory-constrained hosts; entries then
# store NULL embedding and personal scoring collapses to recency + source.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_ENABLED=true

# --- Phase 2: composite scoring weights ---------------------------------------
#
# Final score a card sorts by:
#   composite = w_r * recency + w_p * personal + w_s * (raw_score * source_weight)
#             + w_e * engagement
#
# Weights don't have to sum to 1 — they're multipliers, not probabilities —
# but the defaults do.
SCORING_WEIGHT_RECENCY=0.4
SCORING_WEIGHT_PERSONAL=0.4
SCORING_WEIGHT_SOURCE=0.2
# Engagement weight (phase 4+). The default 0.0 means "engagement
# signal is collected and stored but does NOT influence ranking" —
# safe to leave off until you've verified your source plugins
# populate the engagement meta keys correctly (see app/scoring/
# engagement.py for the per-source key list). A typical
# engagement-on setting is 0.1-0.3.
SCORING_WEIGHT_ENGAGEMENT=0.0

# --- Phase 2: preference vector ----------------------------------------------
#
# The For You feed ranks entries by cosine similarity to a
# preference_vector that's recomputed every N minutes from the user's
# recent interactions. PREFER_VECTOR_BLEND_NEW is the weight given
# to the fresh aggregate vs. the existing vector (0.0-1.0). Lower
# = stickier preferences; 1.0 = overwrite every tick.
# PREFER_VECTOR_BLEND_NEW=0.3
# How often to recompute the preference vector (minutes).
# PREFER_VECTOR_RECOMPUTE_INTERVAL_MINUTES=10
# How many days of interactions feed the recompute.
# PREFER_VECTOR_WINDOW_DAYS=30

# --- Phase 2: convergence boost ----------------------------------------------
#
# Items sharing a normalized title (lowercased, punctuation-stripped, first
# 8 words) within the window get a multiplicative boost on their composite
# score. 2 sources → CONVERGENCE_BOOST_2; 3+ sources → CONVERGENCE_BOOST_3PLUS.
CONVERGENCE_WINDOW_HOURS=24
CONVERGENCE_BOOST_2=1.10
CONVERGENCE_BOOST_3PLUS=1.20

# --- Phase 4: framing tone-tagger (optional) ---------------------------------
#
# Periodically scans the recent entry table, clusters entries by
# embedding similarity, and tags each cluster with a tone (e.g.
# "alarmist", "balanced", "downplay") using a cheap LLM call. The
# results show up as small "framing" indicators on cluster rows in
# the dashboard.
#
# How wide a window to look for clusterable entries (hours).
# FRAMING_WINDOW_HOURS=72
# Cosine-similarity threshold for joining two entries into the
# same cluster. Lower = more aggressive clustering (more
# false-positives); higher = only very-similar stories cluster.
# 0.85-0.95 is a reasonable range; default 0.9.
# FRAMING_SIMILARITY_THRESHOLD=0.9
# How often the clustering job runs (minutes). Cheap (one
# pairwise similarity scan over the last N hours' entries).
# FRAMING_CLUSTER_INTERVAL_MINUTES=60
# Server-side static assets dir (logos, favicons, og:image
# fallbacks). The /assets StaticFiles mount lives here. Default
# ``/app/assets`` inside the production container; bind-mount
# the same path to a host dir for persistence across container
# rebuilds.
# ASSETS_DIR=/app/assets

# --- Reddit (optional) -------------------------------------------------------
#
# Two modes: direct (the backend hits www.reddit.com itself with
# throttling) or proxy (the backend talks to a Reddit-compatible
# proxy like Hydra). The direct mode works for low-traffic homelab
# use; the proxy mode is what large deployments run.
#
# Direct mode (the default; no extra config needed):
#   - The backend uses the .rss endpoint at
#     https://www.reddit.com/r/<subreddit>/<listing>.rss, throttled
#     to 1 request per 75s per IP (configurable below).
#   - Reddit's .json endpoint 403s most residential IPs (see the
#     user's network notes in the README); the .rss path is
#     unaffected.
#
# To force a specific mode, set the relevant env var:
#   REDDIT_DIRECT_DISABLED=true   — disable direct mode entirely
#                                   (Reddit features become no-ops)
#   REDDIT_HYDRA_URL=http://hydra:8080
#                                 — use a Hydra proxy instead. Optional
#                                   REDDIT_HYDRA_TOKEN for auth.
#
# REDDIT_DIRECT_DISABLED=false
# REDDIT_HYDRA_URL=
# REDDIT_HYDRA_TOKEN=